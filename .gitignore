# BERT MLM weights (keep MLM_models/.gitkeep only)
MLM_models/**
!MLM_models/.gitkeep

# FastText static vectors (keep fasttext_models/.gitkeep only)
fasttext_models/**
!fasttext_models/.gitkeep

# llama-cpp wheel probe artifacts (manual install debugging)
**/_wheel_probe*/

# 测试文件夹和测试脚本（仅放行 dirty_data_tests，其他测试文件夹继续屏蔽）
tests/
test/*
!test/dirty_data_tests/
!test/dirty_data_tests/**
test_*.py
