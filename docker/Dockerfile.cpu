# CPU image: core + llm + ocr (paddlepaddle CPU). Models are NOT baked in — mount volumes.
FROM python:3.11-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    INSTALL_PROFILE=cpu

WORKDIR /app

# Lock + metadata first for layer cache
COPY bootup/pyproject.toml bootup/uv.lock bootup/

RUN uv sync --frozen --project bootup --extra llm --extra ocr

COPY . .

# Runtime dirs (also mountable)
RUN mkdir -p temp exports models/gemma4 paddle_ocr/models

EXPOSE 8738

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["uv", "run", "--project", "bootup", "python", "-m", "nicegui_ui.app"]
